# Copy this file to .env on the server and fill in real values.
# Never commit the real .env file anywhere public.

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# PostgreSQL (ArvanCloud DBaaS)
DB_HOST=your-db-host.db.arvandbaas.ir
DB_PORT=5432
DB_USER=base-user
DB_PASSWORD=your-db-password
DB_NAME=postgres
DB_SSL=true

# ArvanCloud Object Storage (S3-compatible)
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_BUCKET=physics-yar-files
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Zarinpal
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_CALLBACK_URL=https://yourdomain.example/api/payment/verify
# set to true while testing without a real merchant id
ZARINPAL_SANDBOX=true

# Comma-separated list of origins allowed to call this API (your GitHub Pages URL)
CORS_ORIGIN=https://emanoel91.github.io
